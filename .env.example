# Copy to .env and fill in. Never commit .env.

# ---- Transactions + features + labels (task 1, Supabase) ----
TXN_BACKEND=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=
TXN_TABLE=transactions
FEATURES_TABLE=features
LABELS_TABLE=labels
TXN_ID_FIELD=transaction_id
LABEL_FIELD=fraud_label
SPLIT_FIELD=split
# MONGO_URI=
# MONGO_DB=

# ---- Graph (task 2, Neo4j) ----
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---- Policy vectors (task 4, Qdrant) ----
QDRANT_URL=https://YOUR-CLUSTER.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sentinel_corpus
PAYLOAD_DOC_FIELD=source_document
PAYLOAD_TITLE_FIELD=title
PAYLOAD_CHUNK_FIELD=chunk_number
PAYLOAD_TEXT_FIELD=text
TOP_K=5

# ---- Euri AI (LLM + embeddings) ----
EURI_API_KEY=
# EMBED_MODEL must match the model used to index Qdrant (3072-d)
EMBED_MODEL=gemini-embedding-2-preview
EMBED_DIM=3072
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1
